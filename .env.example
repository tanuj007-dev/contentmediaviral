# Express API
API_PORT=4001
CORS_ORIGIN=http://localhost:3000

# Admin panel login password
ADMIN_PASSWORD=your-secure-password

# Gmail SMTP (use an App Password if 2FA is enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@contentviralmedia.com
SMTP_PASS=your-app-password
SMTP_FROM=you@contentviralmedia.com
NOTIFY_EMAIL=you@contentviralmedia.com
